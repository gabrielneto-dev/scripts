#!/usr/bin/env bash

set -Eeuo pipefail

COPY_TEMP_FILE="$(mktemp -t tmux-copy.XXXXXX)"
cleanup() {
  if [[ -n ${COPY_TEMP_FILE:-} && -f "$COPY_TEMP_FILE" ]]; then
    rm -f -- "$COPY_TEMP_FILE"
  fi
}
trap cleanup EXIT

cat > "$COPY_TEMP_FILE"

if grep -qi microsoft /proc/version 2>/dev/null && command -v clip.exe >/dev/null 2>&1; then
  clip.exe < "$COPY_TEMP_FILE"
elif [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v wl-copy >/dev/null 2>&1; then
  wl-copy < "$COPY_TEMP_FILE"
elif [[ -n ${DISPLAY:-} ]] && command -v xclip >/dev/null 2>&1; then
  xclip -selection clipboard -in < "$COPY_TEMP_FILE"
else
  encoded="$(base64 -w 0 < "$COPY_TEMP_FILE")"
  client_tty="$(tmux display-message -p '#{client_tty}' 2>/dev/null || true)"
  case "$client_tty" in
    /dev/pts/*|/dev/tty*)
      if [[ -w "$client_tty" ]]; then
        printf '\033]52;c;%s\007' "$encoded" > "$client_tty"
        exit 0
      fi
      ;;
  esac
  printf '\033]52;c;%s\007' "$encoded"
fi
